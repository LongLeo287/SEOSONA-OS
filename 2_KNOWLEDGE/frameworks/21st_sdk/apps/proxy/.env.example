# Service
PORT=3003
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/21st_agents?sslmode=disable
DATABASE_SSL_MODE=disable
CACHE_TTL_MINUTES=8

# Must match the private key used by apps/relay:CLAUDE_PROXY_PRIVATE_JWT.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace_me\n-----END PUBLIC KEY-----"

# Model providers
ANTHROPIC_API_KEY=replace_me
OPENAI_API_KEY=
OPENROUTER_API_KEY=
