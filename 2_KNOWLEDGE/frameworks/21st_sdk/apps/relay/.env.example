# Service
PORT=3002
NODE_ENV=development

# Shared state
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/21st_agents?sslmode=disable
REDIS_URL=redis://localhost:6379

# Public URLs visible from the sandbox runtime.
# If the sandbox is remote, replace localhost with ngrok/AWS tunnel URLs.
RELAY_URL=http://localhost:3002
CLAUDE_PROXY_URL=http://localhost:3003

# Auth and signing
AN_JWT_SECRET=replace_me
CLAUDE_PROXY_PRIVATE_JWT="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----"
GITHUB_TOKEN_ENCRYPTION_KEY=replace_with_64_hex_chars

# E2B backend
E2B_API_KEY=
RELAY_SANDBOX_TEMPLATE=

# OpenSandbox backend alternative
OPENSANDBOX_DOMAIN=
OPENSANDBOX_PROTOCOL=http
OPENSANDBOX_API_KEY=
OPENSANDBOX_RUNTIME_IMAGE=
OPENSANDBOX_USE_SERVER_PROXY=true
OPENSANDBOX_READY_TIMEOUT_SECONDS=120

# Standalone workspace volumes for OpenSandbox on EKS
NEXT_PUBLIC_IS_STANDALONE_APP=false
STANDALONE_EKS_CLUSTER_NAME=
STANDALONE_EKS_CLUSTER_ENDPOINT=
STANDALONE_EKS_CLUSTER_CA_BASE64=
STANDALONE_EKS_NAMESPACE=opensandbox
STANDALONE_WORKSPACE_STORAGE_CLASS=opensandbox-ebs-gp3
STANDALONE_WORKSPACE_STORAGE_SIZE=20Gi
AWS_REGION=

# Optional integrations
INTERNAL_API_SECRET=
BILLING_SETUP_BASE_URL=
METRONOME_BEARER_TOKEN=
METRONOME_TOKENS_EVENT_TYPE=llm_request
OPENROUTER_API_KEY=
E2B_WEBHOOK_SECRET=
VAULT_PROXY_URL=
