    id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    coupon_id           String       @db.Uuid
    team_id             String       @db.Uuid
    user_id             String
    metronome_credit_id String?
    redeemed_at         DateTime     @default(now()) @db.Timestamptz(6)
    coupon              AgentsCoupon @relation(fields: [coupon_id], references: [id], onDelete: Cascade)
    team                Team         @relation(fields: [team_id], references: [id], onDelete: Cascade)

    @@unique([coupon_id, team_id])
    @@index([coupon_id])
    @@index([team_id])
    @@map("agents_coupon_redemptions")
}

/// Records search queries submitted via UI or external API for market analytics
model SearchQuery {
    id         BigInt   @id @default(autoincrement())
    query      String
    /// 'ui' = command-menu / community search bar, 'api' = external REST API
    source     String   @default("ui")
    created_at DateTime @default(now()) @db.Timestamptz(6)

    @@index([created_at(sort: Desc)])
    @@index([source])
    @@map("search_queries")
}
