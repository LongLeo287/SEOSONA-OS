.openai/
.vscode/

# ── Backups ───────────────────────────────────────────────────────────────────
BACKUPS/
backups/
*.bak

# ── Generated / large artifacts (regenerable; kept on disk, out of git) ───────
repos_found.txt
all_github_links.txt
3_MEMORY/knowledge_graph/knowledge_graph.json
# vendored binary blobs that bloated history (fonts, dist bundles, test fixtures)
**/diagram-render.html
**/security-bench-haiku-responses.json
.agents/skills/_TIER_3_BLACKLIST/**/*.woff2*
.agents/skills/_TIER_3_BLACKLIST/**/*.ttf
.agents/skills/_TIER_3_BLACKLIST/**/*.webp

# Quarantined / blacklisted / raw-ingest content (kept local, off GitHub)
_QUARANTINE/
**/_TIER_3_BLACKLIST/
2_KNOWLEDGE/raw_data/ingested_data/

# codebase-memory-mcp binary (local, regenerable from release)
1_CORE/bin/**/*.exe

# TF-IDF KI index — build artifact, rebuilt from KIs on demand (self-heals if missing)
3_MEMORY/vector_index/

# Generated runtime state (regenerated by the pipeline/daemons — not source)
3_MEMORY/uap_queue.json
3_MEMORY/logs/routing_decisions.json
3_MEMORY/vector_index/
# Skill test cassettes/fixtures + heavy downloadable assets (fetched by setup, not source)
.agents/skills/*/tests/cassettes/
.agents/skills/*/.previews/

# Personal Claude Code overrides (project settings.json IS committed — it wires the brain hook)
.claude/settings.local.json

# Runtime log payloads. memory_logger.py spills full file CONTENT >1500 chars into logs/refs/,
# and the compact marker is regenerated every compaction — neither belongs in a public repo.
3_MEMORY/logs/refs/
3_MEMORY/logs/last_compact.json
