# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
dist/

# ── Environment & secrets ──────────────────────────────────────────────────────
.env
.env.*
!.env.example
.DS_Store

# ── IDE-generated rule files (created by `seosona init`, belong in user projects) ──
.cursorrules
.windsurfrules
.clauderules
.clinerules
.roomodes
.antigravityrules
.codexrules
.securecoderrules
.openinterpreter
.aider.conf.yml

# Local external agent skill checkouts. Keep source-of-truth skills in
# SEOSONA knowledge/framework folders, not as nested Git repositories.
# skills are vendored (full); only the heavy ones stay local + manual-install
.agents/skills/kami/assets/
.agents/skills/notebooklm-py/tests/

# ── Build artifacts (generated by `npm run prebuild`) ─────────────────────────
cli/assets/

# ── Raw cloned repos (processed by UAP, then deleted) ─────────────────────────
repos/*/
repos/*.txt
5_RESEARCH/*/
2_KNOWLEDGE/repos/
scratch/

# ── Python cache ──────────────────────────────────────────────────────────────
**/__pycache__/
*.pyc
*.pyo

# ── OS junk ───────────────────────────────────────────────────────────────────
Thumbs.db
*.log
*.lock
*.tmp
*.db
*.sqlite
*.db-journal

# ── API CREDENTIALS — NEVER PUSH ──────────────────────────────────────────────
# User fills in config.json from config_template.json — real keys stay local only
3_MEMORY/specs/config.json
3_MEMORY/specs/gsc_service_account.json
3_MEMORY/specs/.vault
3_MEMORY/specs/.masterkey
*.service_account.json
*_credentials.json
service_account.json
1_CONFIG/service_account.json
1_CONFIG/service_account*.json
# Local runtime configs (machine-specific paths / API keys) — keep .example tracked
1_CONFIG/api_gateway_config.json
1_CONFIG/workspaces.json

# ── INGESTION ZONE (raw cloned data, ephemeral) ──────────────────────────────
3_MEMORY/ingestion_zone/

# ── AUDIT EXPORTS — ALL PRIVATE ───────────────────────────────────────────────
# All seo_exports are test/client data — never push any domain
3_MEMORY/seo_exports/
3_MEMORY/audit_reports/

# ── SESSION LOGS ──────────────────────────────────────────────────────────────
# Raw session transcripts = private conversation data → IGNORED
3_MEMORY/logs/*.jsonl
3_MEMORY/logs/*.jsonl.lock
# System/dev logs (README, phase notes, build logs) → TRACKED automatically
# because they don't match the *.jsonl pattern above

# SEOSONA encrypted secrets
*.vault

# Project runtime event streams
3_MEMORY/projects/*/changelog/*.jsonl

# Tracked external reference snapshots
!5_RESEARCH/ingest_batch_uiux/anime/dist/
!5_RESEARCH/ingest_batch_uiux/anime/dist/**
!5_RESEARCH/ingest_batch_uiux/typeui/plugins/zed/typeui/Cargo.lock
!5_RESEARCH/ingest_batch_uiux/ui-ux-pro-max-skill/cli/bun.lock

