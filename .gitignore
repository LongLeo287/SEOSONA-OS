# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
dist/

# ── Environment & secrets ──────────────────────────────────────────────────────
.env
.env.*
!.env.example
.DS_Store

# ── IDE-generated rule files (created by `seosona init`, belong in user projects) ──
.cursorrules
.windsurfrules
.clauderules
.clinerules
.roomodes
.antigravityrules
.codexrules
.securecoderrules
.openinterpreter
.aider.conf.yml

# ── Build artifacts (generated by `npm run prebuild`) ─────────────────────────
cli/assets/
cli/README.md

# ── Raw cloned repos (processed by UAP, then deleted) ─────────────────────────
repos/*/
repos/*.txt

# ── Python cache ──────────────────────────────────────────────────────────────
**/__pycache__/
*.pyc
*.pyo

# ── OS junk ───────────────────────────────────────────────────────────────────
Thumbs.db
*.log
*.lock

# ── API CREDENTIALS — NEVER PUSH ──────────────────────────────────────────────
# User fills in config.json from config_template.json — real keys stay local only
3_MEMORY/specs/config.json
3_MEMORY/specs/gsc_service_account.json
3_MEMORY/specs/.vault
3_MEMORY/specs/.masterkey
*.service_account.json
*_credentials.json
service_account.json
1_CONFIG/service_account.json
1_CONFIG/service_account*.json

# ── INGESTION ZONE (raw cloned data, ephemeral) ──────────────────────────────
3_MEMORY/ingestion_zone/

# ── AUDIT EXPORTS — ALL PRIVATE ───────────────────────────────────────────────
# All seo_exports are test/client data — never push any domain
3_MEMORY/seo_exports/

# ── SESSION LOGS ──────────────────────────────────────────────────────────────
# Raw session transcripts = private conversation data → IGNORED
3_MEMORY/logs/*.jsonl
3_MEMORY/logs/*.jsonl.lock
# System/dev logs (README, phase notes, build logs) → TRACKED automatically
# because they don't match the *.jsonl pattern above

# SEOSONA encrypted secrets
*.vault
