{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_comment": "Hooks are audited before registration — see docs/audits/HOOKS_AUDIT_2026-07-24.md. dev-rules-reminder, subagent-init, descriptive-name and write-compact-marker were deleted outright (dead, duplicated, or actively harmful — reasons in the audit). Individual hooks can be toggled via .ck.json hooks.<name>.",
  "statusLine": {
    "type": "command",
    "command": "node .claude/statusline.cjs"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["1_CORE/hooks/session-init.cjs"],
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["1_CORE/hooks/brain-inject.cjs"],
            "timeout": 10,
            "statusMessage": "Consulting the SEOSONA brain..."
          },
          {
            "type": "command",
            "command": "node",
            "args": ["1_CORE/hooks/usage-context-awareness.cjs"],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Glob|Grep|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["1_CORE/hooks/scout-block.cjs"],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": ["1_CORE/hooks/privacy-block.cjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["1_CORE/hooks/post-edit-simplify-reminder.cjs"],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": ["1_CORE/hooks/memory-logger.cjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["1_CORE/hooks/session-end.cjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
