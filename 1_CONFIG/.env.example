# ================================================================
# SEOSONA OS — MASTER ENVIRONMENT VARIABLES (TEMPLATE)
# ================================================================
# Copy this file to `.env` and fill in your actual API keys.
# IMPORTANT: DO NOT commit the actual `.env` file to version control.
# ================================================================


# ────────────────────────────────────────────────────────────────
# 1. CORE AI PROVIDERS
# ────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY="AIzaSy..."


# ────────────────────────────────────────────────────────────────
# 2. DATA EXTRACTION & OSINT
# ────────────────────────────────────────────────────────────────
# Firecrawl: Deep Web Scraping (Grand Audit + MCP Server)
FIRECRAWL_API_KEY="fc-..."

# Neo4j Graph Database — OSINT Graph Investigation (Flowsint)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-password"

# Brave Search — Agent search capabilities
BRAVE_API_KEY=""


# ────────────────────────────────────────────────────────────────
# 3. GOOGLE APIs (GSC, GA4, PageSpeed, Trends)
# ────────────────────────────────────────────────────────────────
# Service account JSON for GSC & GA4 connectors
GOOGLE_APPLICATION_CREDENTIALS="1_CONFIG/service_account.json"

# PageSpeed Insights & CrUX — Web Vitals analysis
PAGESPEED_API_KEY="AIzaSy..."
CRUX_API_KEY=""

# Google Gemini — used by MCP human-mcp server
GOOGLE_GEMINI_API_KEY=""

# YouTube Data API - public video/channel/search metadata.
YOUTUBE_API_KEY=""

# Google Safe Browsing - website malware/phishing checks.
GOOGLE_SAFE_BROWSING_API_KEY=""


# ────────────────────────────────────────────────────────────────
# 4. SEO & MARKETING TOOLS
# ────────────────────────────────────────────────────────────────
# DataForSEO — Programmatic SERP checking & Backlink analysis
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# Open PageRank — Domain authority scoring
OPEN_PAGERANK_KEY=""

# Bing Webmaster — Bing search index management
BING_WEBMASTER_KEY=""

# SerpAPI — Google SERP scraping (keyword-explorer, serp-analyzer)
SERPAPI_KEY=""

# Tavily — AI search API for research agents
TAVILY_API_KEY=""

# SendGrid — Transactional email delivery
SENDGRID_API_KEY=""

# Website and SEO security utilities.
URLSCAN_API_KEY=""


# ----------------------------------------------------------------
# 4A. VIDEO, YOUTUBE, AND MEDIA APIs
# ----------------------------------------------------------------
# Pexels and Pixabay - free stock video/image APIs.
PEXELS_API_KEY=""
PIXABAY_API_KEY=""

# Vimeo and Dailymotion - video platform APIs.
VIMEO_ACCESS_TOKEN=""
DAILYMOTION_API_KEY=""


# ----------------------------------------------------------------
# 4B. SOCIAL MEDIA APIs
# ----------------------------------------------------------------
# Bluesky AT Protocol - authenticated social actions.
BLUESKY_IDENTIFIER=""
BLUESKY_APP_PASSWORD=""

# Mastodon public API - instance base URL, not a secret.
MASTODON_INSTANCE="https://mastodon.social"

# Bot/community/social APIs.
TELEGRAM_BOT_TOKEN=""
DISCORD_BOT_TOKEN=""

# Reddit API - app credentials plus descriptive user agent.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="SEOSONA-OS/3.0 by your_reddit_username"

# Meta, TikTok, and Pinterest developer APIs.
META_ACCESS_TOKEN=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
PINTEREST_ACCESS_TOKEN=""


# ────────────────────────────────────────────────────────────────
# 5. SCIENCE & MEDICAL APIs
# ────────────────────────────────────────────────────────────────
# NCBI — PubMed, ClinVar, Sequence Fetch (rate limit: 3→10 req/s)
NCBI_API_KEY=""

# OpenFDA — Drug/device/food adverse event queries
FDA_API_KEY=""

# OpenAlex - scholarly metadata API. Free key recommended/required for scale.
OPENALEX_API_KEY=""

# Crossref polite pool identity. Use a contact email, not a secret.
CROSSREF_MAILTO="you@example.com"

# Wikidata Query Service user agent. Use a descriptive app/contact string.
WIKIDATA_USER_AGENT="SEOSONA-OS/3.0 (contact: you@example.com)"


# ────────────────────────────────────────────────────────────────
# 6. EMAIL & OUTREACH (Cold Outbound Engine)
# ────────────────────────────────────────────────────────────────
SENDER_EMAIL=""
SENDER_NAME=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""


# ────────────────────────────────────────────────────────────────
# 7. MCP SERVER TOKENS
# ────────────────────────────────────────────────────────────────
# GitHub MCP Server — Repository access
GITHUB_PERSONAL_ACCESS_TOKEN=""

# Context7 MCP Server
CONTEXT7_API_KEY=""


# ────────────────────────────────────────────────────────────────
# 8. SYSTEM UTILITIES & CI/CD
# ────────────────────────────────────────────────────────────────
GITHUB_TOKEN="github_pat_..."

# GA4 Property ID — for analytics connector
GA4_PROPERTY_ID=""


# ────────────────────────────────────────────────────────────────
# 9. SEOSONA SYSTEM PROMPTS (Auto-set by `seosona setup`)
# ────────────────────────────────────────────────────────────────
# These are auto-populated by the CLI setup wizard.
# ANTIGRAVITY_SYSTEM_PROMPT=<auto>
# SEOSONA_MASTER_PROMPT=<auto>
# AIDER_SYSTEM_PROMPT=<auto>
