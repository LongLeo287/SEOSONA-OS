{
  "_comment": "Template shipped into connected projects by `seosona init`. Paths use $HOME (NOT ~) because a tilde inside double quotes is never expanded by the shell — the previous form pointed every hook at a literal './~/' directory and silently failed. Hook set is curated: see docs/audits for why dev-rules-reminder, subagent-init, descriptive-name, usage-context-awareness and write-compact-marker are intentionally not registered.",
  "includeCoAuthoredBy": false,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.seosona/1_CORE/hooks/session-init.cjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.seosona/1_CORE/hooks/brain-inject.cjs\"",
            "timeout": 10,
            "statusMessage": "Consulting the SEOSONA brain..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Glob|Grep|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.seosona/1_CORE/hooks/scout-block.cjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$HOME/.seosona/1_CORE/hooks/privacy-block.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.seosona/1_CORE/hooks/post-edit-simplify-reminder.cjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$HOME/.seosona/1_CORE/hooks/memory-logger.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.seosona/1_CORE/hooks/session-end.cjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
